# Multi-stage production build for Angular (esbuild application builder).
FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate
COPY package.json pnpm-lock.yaml* ./
RUN printf '%s\n' \
      'allowBuilds:' \
      "  '@parcel/watcher': true" \
      '  esbuild: true' \
      '  less: false' \
      '  lmdb: true' \
      '  msgpackr-extract: true' \
      '  nx: false' \
      > pnpm-workspace.yaml
RUN --mount=type=cache,id=pnpm-frontend-prod,target=/root/.local/share/pnpm/store \
    pnpm install --no-frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm build

FROM nginx:alpine AS prod
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/frontend-ng/browser /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
