# Base URL del backend (inyectada en build por scripts/run-with-api-env.mjs).
# En local (localhost) no hace falta: ng serve usa el proxy.
# En Vercel: define las mismas vars en Project Settings → Environment Variables.
#
# El backend vive en Render (antes Railway). Ajusta la URL a la real que Render
# asigne al servicio `genova-backend` (Dashboard → el servicio → cabecera).
GENOVA_API_BASE_PROD=https://genova-backend-lbdr.onrender.com
GENOVA_API_BASE_DEVELOP=https://genova-backend-lbdr.onrender.com
# Opcional: un solo valor para todo el deploy (sobrescribe prod/develop).
# GENOVA_API_BASE_URL=
