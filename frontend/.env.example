# Base URL del backend (inyectada en build por scripts/write-api-env.mjs).
# En local (localhost) no hace falta: ng serve usa el proxy.
# En Vercel: define las mismas vars en Project Settings → Environment Variables.
GENOVA_API_BASE_PROD=https://genova-backend-production.up.railway.app
GENOVA_API_BASE_DEVELOP=https://genova-backend-develop.up.railway.app
# Opcional: un solo valor para todo el deploy (sobrescribe prod/develop).
# GENOVA_API_BASE_URL=
