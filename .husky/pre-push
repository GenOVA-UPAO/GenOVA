#!/usr/bin/env sh
# Verificación antes de push — reemplaza al antiguo verify.ps1.
# Se puede saltar con: git push --no-verify
set -e

echo "[pre-push] Frontend: lint"
pnpm lint

echo "[pre-push] Frontend: typecheck (tsc)"
pnpm typecheck

echo "[pre-push] Frontend: tests unitarios (vitest)"
pnpm test:vitest

# Cómo ejecutar las herramientas del backend. Desde WSL el venv suele ser de
# Windows (backend/.venv/Scripts) y `uv run` a secas intenta recrearlo: el push
# se quedaba colgado sin imprimir nada. Se prueba el intérprete del venv, luego
# el del sistema y por último uv --no-sync; si ninguno tiene la herramienta se
# avisa y se omite (CI vuelve a ejecutar estas comprobaciones en cada PR).
backend_py=""
for candidate in backend/.venv/bin/python backend/.venv/Scripts/python.exe; do
  if [ -x "$candidate" ] && "$candidate" -c "import sys" >/dev/null 2>&1; then
    backend_py="$candidate"
    break
  fi
done

# run_backend_python <módulo requerido> <argumentos de python...>: ejecuta el
# primer intérprete del backend que puede importar el módulo.
run_backend_python() {
  module="$1"
  shift
  if [ -n "$backend_py" ] && ( cd backend && "../$backend_py" -c "import $module" ) >/dev/null 2>&1; then
    ( cd backend && "../$backend_py" "$@" )
  elif python -c "import $module" >/dev/null 2>&1; then
    ( cd backend && python "$@" )
  elif command -v uv >/dev/null 2>&1 && ( cd backend && uv run --no-sync python -c "import $module" ) >/dev/null 2>&1; then
    ( cd backend && uv run --no-sync python "$@" )
  else
    echo "[pre-push] $module no disponible en el entorno — se omite (CI lo comprueba igualmente)"
    echo "[pre-push] recupéralo con: cd backend && uv sync --extra dev"
  fi
}

# run_backend_tool <módulo> <argumentos...>: `python -m <módulo>`.
run_backend_tool() {
  run_backend_python "$1" -m "$@"
}

echo "[pre-push] Backend: ruff"
run_backend_tool ruff check .

echo "[pre-push] Backend: fronteras de arquitectura (import-linter) + tamaño de módulos"
# Ejecutar importlinter.cli como módulo no hace nada (no tiene __main__) y
# salía con 0: se llama a la función del script de consola `lint-imports`.
run_backend_python importlinter -c 'import sys; from importlinter.cli import lint_imports_command; sys.exit(lint_imports_command())'
if [ -n "$backend_py" ]; then
  ( cd backend && "../$backend_py" scripts/check_module_size.py )
fi

echo "[pre-push] Backend: BDD (solo si el backend responde en :8000)"
if curl -fsS http://localhost:8000/health >/dev/null 2>&1; then
  run_backend_tool pytest tests/step_defs/ -q
else
  printf '\033[1;33m[pre-push] ADVERTENCIA: backend no está en :8000 — se omiten los BDD.\033[0m\n'
  printf '\033[33m[pre-push] Para correrlos: levanta el backend (cd backend && uvicorn main:app --port 8000) y ejecuta: cd backend && python -m pytest tests/step_defs/ -q\033[0m\n'
fi

echo "[pre-push] OK"
