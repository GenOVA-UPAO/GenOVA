# Misma versión que CI (setup-python 3.11): lo que se prueba es lo que corre.
FROM python:3.11-slim

# uv: instalador de dependencias ~10x más rápido que pip (binario oficial).
# Versión fija: con :latest dos builds del mismo commit podían usar uv distintos.
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_LINK_MODE=copy

# Railway builds from repo root with dockerfilePath=/backend/Dockerfile.prod,
# so COPY paths must include the backend/ prefix.
COPY backend/requirements.txt ./
# Sin cache mount: Railway Metal exige id=s/<service-id>-… y este Dockerfile lo
# comparten los servicios web y worker (ids distintos) — un id hardcodeado rompe
# el build del otro servicio. uv instala en <1 min; el caché no compensa el acople.
# requirements.txt sigue siendo la fuente (paridad pip/uv); --system = sin venv.
# --no-cache: la caché de wheels no queda en la capa (casi duplicaba la imagen).
RUN uv pip install --system --no-cache -r requirements.txt

# Sin root: un fallo en un parser de subidas (pypdf, docx, pptx, lxml, Pillow) no
# da root en el contenedor. /app es del usuario porque la app escribe ahí (zips
# SCORM y uploads temporales por defecto); --chown evita una capa duplicada.
RUN useradd --create-home --uid 10001 app && chown app:app /app
COPY --chown=app:app backend/ .
USER app

EXPOSE 8000

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
