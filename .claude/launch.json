{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docker",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "setInterval(()=>{},9999999)"],
      "port": 4200
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 4200,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["main:app", "--reload", "--port", "8000", "--app-dir", "backend"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "backend-carga",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-ExecutionPolicy", "Bypass", "-File", "scripts/serve-load.ps1"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "backend-carga-pool",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-ExecutionPolicy", "Bypass", "-File", "scripts/serve-load-pool.ps1"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "backend-noreload",
      "runtimeExecutable": "backend/.venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["main:app", "--port", "8000", "--app-dir", "backend"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "deployed-proxy",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/preview-proxy.js"],
      "port": 4200,
      "autoPort": false
    },
    {
      "name": "audit",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", ".audit"],
      "port": 8090
    }
  ]
}
