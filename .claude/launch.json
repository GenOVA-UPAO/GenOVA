{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docker",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "setInterval(()=>{},9999999)"],
      "port": 4200
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 4200,
      "autoPort": false
    },
    {
      "name": "audit",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", ".audit"],
      "port": 8090
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "storybook"],
      "port": 6006
    }
  ]
}
